# Private implementation of docs/versioning.md. No caller version override.
include_guard(GLOBAL)

function(_meshvale_geometry_normalize_name output value)
  string(TOLOWER "${value}" normalized)
  string(REGEX REPLACE "[-_.]+" "-" normalized "${normalized}")
  set("${output}" "${normalized}" PARENT_SCOPE)
endfunction()

function(_meshvale_geometry_stable output value)
  if(NOT "${value}" MATCHES "^([0-9]+)[.]([0-9]+)[.]([0-9]+)$")
    set("${output}" "" PARENT_SCOPE)
    return()
  endif()
  set(parts "${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}" "${CMAKE_MATCH_3}")
  set(canonical "")
  foreach(part IN LISTS parts)
    string(REGEX REPLACE "^0+" "" part "${part}")
    if(part STREQUAL "")
      set(part 0)
    endif()
    list(APPEND canonical "${part}")
  endforeach()
  list(JOIN canonical "." canonical)
  set("${output}" "${canonical}" PARENT_SCOPE)
endfunction()

function(_meshvale_geometry_tag output value)
  set(version "")
  if("${value}" MATCHES "^v([0-9]+[.][0-9]+[.][0-9]+)$")
    _meshvale_geometry_stable(version "${CMAKE_MATCH_1}")
  endif()
  set("${output}" "${version}" PARENT_SCOPE)
endfunction()

function(_meshvale_geometry_classify out_kind out_version value)
  _meshvale_geometry_stable(version "${value}")
  if(NOT version STREQUAL "")
    set(kind stable)
  else()
    string(TOLOWER "${value}" lower)
    set(local "[a-z0-9]+([._-][a-z0-9]+)*")
    if(lower MATCHES "^[0-9]+[.][0-9]+[.][0-9]+[.]dev[0-9]+([+]${local})?$"
        OR lower MATCHES "^[0-9]+[.][0-9]+[.][0-9]+[+]${local}$")
      set(kind development)
      set(version 0.0.0)
    else()
      message(FATAL_ERROR "MeshvaleGeometry: unsupported or malformed full source version '${value}'")
    endif()
  endif()
  set("${out_kind}" "${kind}" PARENT_SCOPE)
  set("${out_version}" "${version}" PARENT_SCOPE)
endfunction()

function(_meshvale_geometry_lines output path)
  file(READ "${path}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  string(REPLACE ";" "\\;" text "${text}")
  string(REPLACE "\n" ";" text "${text}")
  set("${output}" "${text}" PARENT_SCOPE)
endfunction()

function(_meshvale_geometry_pkg_info out_kind out_version path)
  _meshvale_geometry_lines(lines "${path}")
  set(previous "")
  set(name_count 0)
  set(version_count 0)
  foreach(line IN LISTS lines)
    if(line STREQUAL "")
      break()
    endif()
    if(line MATCHES "^[ \t]")
      if(previous STREQUAL "name" OR previous STREQUAL "version")
        message(FATAL_ERROR "MeshvaleGeometry: folded PKG-INFO identity")
      endif()
      continue()
    endif()
    set(previous "")
    if(line MATCHES "^([^:]+):(.*)$")
      string(TOLOWER "${CMAKE_MATCH_1}" header)
      set(value "${CMAKE_MATCH_2}")
      string(REGEX REPLACE "^[ \t]+|[ \t]+$" "" value "${value}")
      if(header STREQUAL "name")
        math(EXPR name_count "${name_count}+1")
        _meshvale_geometry_normalize_name(name "${value}")
        set(previous name)
      elseif(header STREQUAL "version")
        math(EXPR version_count "${version_count}+1")
        set(full "${value}")
        set(previous version)
      endif()
    endif()
  endforeach()
  if(NOT name_count EQUAL 1 OR NOT version_count EQUAL 1
      OR NOT name STREQUAL "meshvale-geometry" OR full STREQUAL "")
    message(FATAL_ERROR "MeshvaleGeometry: invalid product-named PKG-INFO identity")
  endif()
  _meshvale_geometry_classify(kind version "${full}")
  set("${out_kind}" "${kind}" PARENT_SCOPE)
  set("${out_version}" "${version}" PARENT_SCOPE)
endfunction()

function(_meshvale_geometry_archive out_kind out_version path)
  _meshvale_geometry_lines(lines "${path}")
  set(keys "")
  foreach(line IN LISTS lines)
    if(line STREQUAL "")
      continue()
    endif()
    if(NOT line MATCHES "^(meshvale-project|node|node-date|describe-name|ref-names): (.*)$")
      message(FATAL_ERROR "MeshvaleGeometry: malformed archival field")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    if(key IN_LIST keys)
      message(FATAL_ERROR "MeshvaleGeometry: duplicate archival field '${key}'")
    endif()
    list(APPEND keys "${key}")
    set("field_${key}" "${value}")
  endforeach()
  list(LENGTH keys count)
  if(NOT count EQUAL 5 OR NOT field_meshvale-project STREQUAL "meshvale-geometry")
    message(FATAL_ERROR "MeshvaleGeometry: missing or wrong-product archival identity")
  endif()
  set(template_node "$Format:%H$")
  set(template_node-date "$Format:%cI$")
  set(template_describe-name "$Format:%(describe:tags=true,match=v[0-9]*)$")
  set(template_ref-names "$Format:%D$")
  set(unexpanded 0)
  foreach(key IN ITEMS node node-date describe-name ref-names)
    if("${field_${key}}" STREQUAL "${template_${key}}")
      math(EXPR unexpanded "${unexpanded}+1")
    elseif("${field_${key}}" MATCHES "[$]Format:")
      message(FATAL_ERROR "MeshvaleGeometry: malformed archival placeholder")
    endif()
  endforeach()
  if(unexpanded EQUAL 4)
    set("${out_kind}" neutral PARENT_SCOPE)
    set("${out_version}" 0.0.0 PARENT_SCOPE)
    return()
  elseif(NOT unexpanded EQUAL 0)
    message(FATAL_ERROR "MeshvaleGeometry: partial archival substitution")
  endif()
  string(LENGTH "${field_node}" node_length)
  if(NOT field_node MATCHES "^[0-9a-fA-F]+$"
      OR (NOT node_length EQUAL 40 AND NOT node_length EQUAL 64))
    message(FATAL_ERROR "MeshvaleGeometry: malformed archival node")
  endif()
  if(NOT field_node-date MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9][+-][0-9][0-9]:[0-9][0-9]$")
    message(FATAL_ERROR "MeshvaleGeometry: malformed archival node-date")
  endif()
  set(versions "")
  set(describe_is_exact_ref FALSE)
  # Git refs cannot contain spaces. Only ', ' separates %D records; commas
  # and semicolons inside a legal tag must remain part of that complete token.
  string(REPLACE ";" "\\;" refs "${field_ref-names}")
  string(REPLACE ", " ";" refs "${refs}")
  foreach(ref IN LISTS refs)
    string(STRIP "${ref}" ref)
    if(ref MATCHES "^tag: (.*)$")
      set(exact_tag "${CMAKE_MATCH_1}")
      if(exact_tag STREQUAL field_describe-name)
        set(describe_is_exact_ref TRUE)
      endif()
      _meshvale_geometry_tag(version "${exact_tag}")
      if(NOT version STREQUAL "")
        list(APPEND versions "${version}")
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES versions)
  list(LENGTH versions version_count)
  if(version_count GREATER 1)
    message(FATAL_ERROR "MeshvaleGeometry: ambiguous archival stable tags")
  endif()
  set(describe "${field_describe-name}")
  set(distance 0)
  # A legal exact tag can itself resemble describe's distance/hash suffix.
  if(NOT describe_is_exact_ref AND describe MATCHES "^(.+)-([0-9]+)-g([0-9a-fA-F]+)$")
    set(describe "${CMAKE_MATCH_1}")
    set(distance "${CMAKE_MATCH_2}")
    string(TOLOWER "${CMAKE_MATCH_3}" short_node)
    string(TOLOWER "${field_node}" node)
    string(FIND "${node}" "${short_node}" prefix)
    if(NOT prefix EQUAL 0)
      message(FATAL_ERROR "MeshvaleGeometry: archival describe/node conflict")
    endif()
  endif()
  if(NOT distance MATCHES "^0+$" AND version_count EQUAL 1)
    message(FATAL_ERROR "MeshvaleGeometry: archival distance/ref conflict")
  endif()
  _meshvale_geometry_tag(described_version "${describe}")
  if(NOT described_version STREQUAL "")
    if(distance MATCHES "^0+$")
      if(NOT version_count EQUAL 1 OR NOT versions STREQUAL described_version)
        message(FATAL_ERROR "MeshvaleGeometry: archival describe/ref conflict")
      endif()
    endif()
  endif()
  if(version_count EQUAL 1)
    set(kind stable)
    set(version "${versions}")
  else()
    set(kind development)
    set(version 0.0.0)
  endif()
  set("${out_kind}" "${kind}" PARENT_SCOPE)
  set("${out_version}" "${version}" PARENT_SCOPE)
endfunction()

function(meshvale_geometry_resolve_source_version out_version out_provenance source_root)
  file(REAL_PATH "${source_root}" root)
  set(version 0.0.0)
  set(provenance unversioned-development)
  set(release FALSE)
  find_package(Git QUIET)
  if(Git_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse --show-toplevel
      RESULT_VARIABLE git_result OUTPUT_VARIABLE git_root
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(git_result EQUAL 0)
      file(REAL_PATH "${git_root}" git_root)
    endif()
  else()
    set(git_result 1)
  endif()
  if(git_result EQUAL 0 AND git_root STREQUAL root)
    set(provenance git-development)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" status --porcelain --untracked-files=all
      RESULT_VARIABLE status_result OUTPUT_VARIABLE status ERROR_QUIET)
    if(status_result EQUAL 0 AND status STREQUAL "")
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" tag --points-at HEAD
        RESULT_VARIABLE tag_result OUTPUT_VARIABLE tags ERROR_QUIET)
      if(NOT tag_result EQUAL 0)
        message(FATAL_ERROR "MeshvaleGeometry: cannot enumerate exact source tags")
      endif()
      string(REPLACE ";" "\\;" tags "${tags}")
      string(REPLACE "\n" ";" tags "${tags}")
      set(versions "")
      foreach(tag IN LISTS tags)
        string(STRIP "${tag}" tag)
        _meshvale_geometry_tag(candidate "${tag}")
        if(NOT candidate STREQUAL "")
          list(APPEND versions "${candidate}")
        endif()
      endforeach()
      list(REMOVE_DUPLICATES versions)
      list(LENGTH versions count)
      if(count GREATER 1)
        message(FATAL_ERROR "MeshvaleGeometry: ambiguous exact stable source tags")
      elseif(count EQUAL 1)
        set(version "${versions}")
        set(release TRUE)
        set(provenance git-release)
      endif()
    endif()
  elseif(EXISTS "${root}/.git")
    set(provenance git-unverified-development)
  else()
    set(archive_kind neutral)
    set(archive_version 0.0.0)
    if(EXISTS "${root}/.git_archival.txt")
      _meshvale_geometry_archive(archive_kind archive_version "${root}/.git_archival.txt")
      if(NOT archive_kind STREQUAL "neutral")
        set(provenance "archive-${archive_kind}")
      endif()
    endif()
    if(EXISTS "${root}/PKG-INFO")
      _meshvale_geometry_pkg_info(pkg_kind pkg_version "${root}/PKG-INFO")
      if(archive_kind STREQUAL "stable")
        if(NOT pkg_kind STREQUAL "stable" OR NOT pkg_version STREQUAL archive_version)
          message(FATAL_ERROR "MeshvaleGeometry: archive/PKG-INFO release conflict")
        endif()
      elseif(archive_kind STREQUAL "development" AND pkg_kind STREQUAL "stable"
          AND NOT pkg_version STREQUAL "0.0.0")
        message(FATAL_ERROR "MeshvaleGeometry: development archive/stable PKG-INFO conflict")
      endif()
      if(pkg_kind STREQUAL "stable" AND NOT pkg_version STREQUAL "0.0.0")
        set(version "${pkg_version}")
        set(release TRUE)
        set(provenance sdist-release)
      elseif(provenance STREQUAL "unversioned-development")
        set(provenance sdist-development)
      endif()
    endif()
    if(archive_kind STREQUAL "stable")
      set(version "${archive_version}")
      set(release TRUE)
      set(provenance archive-release)
    endif()
  endif()
  if(DEFINED SKBUILD_PROJECT_NAME)
    _meshvale_geometry_normalize_name(backend_name "${SKBUILD_PROJECT_NAME}")
    if(backend_name STREQUAL "meshvale-geometry")
      if(NOT DEFINED SKBUILD_PROJECT_VERSION_FULL)
        message(FATAL_ERROR "MeshvaleGeometry: matching backend name requires FULL version")
      endif()
      _meshvale_geometry_classify(backend_kind backend_version "${SKBUILD_PROJECT_VERSION_FULL}")
      if(release)
        if(NOT backend_kind STREQUAL "stable" OR NOT backend_version STREQUAL version)
          message(FATAL_ERROR "MeshvaleGeometry: source/backend FULL release conflict")
        endif()
      elseif(backend_kind STREQUAL "stable" AND NOT backend_version STREQUAL "0.0.0")
        message(FATAL_ERROR "MeshvaleGeometry: stable FULL lacks matching source provenance")
      endif()
    endif()
  endif()
  set("${out_version}" "${version}" PARENT_SCOPE)
  set("${out_provenance}" "${provenance}" PARENT_SCOPE)
endfunction()
